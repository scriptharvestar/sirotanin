RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    local cam = GetCamera()
    if not cam then return end

    if FOVCircle.Visible then FOVCircle.Position = cam.ViewportSize / 2 end

    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        if hum then
            if CFG.Speed then hum.WalkSpeed = CFG.SpeedVal end
            if CFG.Jump then 
                hum.UseJumpPower = true
                hum.JumpPower = CFG.JumpVal 
            end
        end

        if root then
            if CFG.GravityEnabled then
                workspace.Gravity = CFG.GravityVal
            else
                workspace.Gravity = 196.2
            end

            if CFG.Spinbot then
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(CFG.SpinSpeed), 0)
            end

            if CFG.Noclip then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end

        if CFG.Bhop and hum and hum.FloorMaterial ~= Enum.Material.Air then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    if CFG.CamFOVEnabled then
        cam.FieldOfView = CFG.CamFOVVal
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESP_List[player] then CreateESP(player) end
            local d = ESP_List[player]
            local pChar = player.Character
            local root = pChar and pChar:FindFirstChild("HumanoidRootPart")
            local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")

            if pChar and root and hum and hum.Health > 0 then
                local pos, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen then
                    local dist = (cam.CFrame.Position - root.Position).Magnitude

                    if CFG.ESP_Name then
                        d.Name.Visible = true
                        d.Name.Text = player.Name
                        d.Name.Position = Vector2.new(pos.X, pos.Y - 35)
                    else
                        d.Name.Visible = false
                    end

                    if CFG.ESP_Dist then
                        d.Dist.Visible = true
                        d.Dist.Text = math.floor(dist) .. " studs"
                        d.Dist.Position = Vector2.new(pos.X, pos.Y + 25)
                    else
                        d.Dist.Visible = false
                    end

                    if CFG.Tracers then
                        d.Tracer.Visible = true
                        d.Tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                        d.Tracer.To = Vector2.new(pos.X, pos.Y)
                        d.Tracer.Color = Color3.fromRGB(255, 255, 255)
                    else
                        d.Tracer.Visible = false
                    end

                    if CFG.ESP_Health then
                        local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        d.HealthBg.Visible = true
                        d.Health.Visible = true
                        d.HealthBg.From = Vector2.new(pos.X - 22, pos.Y - 20)
                        d.HealthBg.To = Vector2.new(pos.X - 22, pos.Y + 20)
                        d.HealthBg.Color = Color3.fromRGB(0, 0, 0)

                        d.Health.From = Vector2.new(pos.X - 22, pos.Y + 20)
                        d.Health.To = Vector2.new(pos.X - 22, pos.Y + 20 - (40 * healthPercent))
                        d.Health.Color = Color3.fromRGB(0, 255, 0)
                    else
                        d.HealthBg.Visible = false
                        d.Health.Visible = false
                    end
                else
                    for _, obj in pairs(d) do obj.Visible = false end
                end
            else
                if ESP_List[player] then
                    for _, obj in pairs(ESP_List[player]) do obj.Visible = false end
                end
            end
        end
    end

    if CFG.AimEnabled then  
        local target, shortest = nil, CFG.AimFOV  
        for _, player in ipairs(Players:GetPlayers()) do  
            if player ~= LocalPlayer and (not CFG.TeamCheck or player.Team ~= LocalPlayer.Team) then  
                local pChar = player.Character  
                local pPart = pChar and pChar:FindFirstChild(CFG.AimPart)  
                local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")  
                if pPart and pHum and pHum.Health > 0 then  
                    local isVisible = true
                    if CFG.VisibilityCheck then
                        local ray = Ray.new(cam.CFrame.Position, (pPart.Position - cam.CFrame.Position).Unit * 500)
                        local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
                        if hit and not hit:IsDescendantOf(pChar) then
                            isVisible = false
                        end
                    end

                    if isVisible then
                        local targetPos = pPart.Position
                        if CFG.Prediction and pChar:FindFirstChild("HumanoidRootPart") then
                            local targetVel = pChar.HumanoidRootPart.Velocity
                            targetPos = targetPos + (targetVel * (CFG.PredictionFactor * 0.033))
                        end

                        local screenPos, onScreen = cam:WorldToViewportPoint(targetPos)  
                        if onScreen then  
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - (cam.ViewportSize / 2)).Magnitude  
                            if dist < shortest then 
                                shortest = dist 
                                target = targetPos 
                            end  
                        end  
                    end
                end  
            end  
        end  
        if target then 
            if CFG.Smoothness <= 0 then
                cam.CFrame = CFrame.new(cam.CFrame.Position, target)
            else
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target), 1 / CFG.Smoothness) 
            end
        end  
    end
end)

