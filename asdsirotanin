task.spawn(function()
    while task.wait(0.2) do
        for _, player in ipairs(Players:GetPlayers()) do  
            if player ~= LocalPlayer and player.Character then  
                local pChar = player.Character  
                local rootPart = pChar:FindFirstChild("HumanoidRootPart")  
                  
                if rootPart then  
                    local highlight = pChar:FindFirstChild("sirotaninHitboxGlow")  
                      
                    if CFG.HitboxEnabled then  
                        rootPart.Size = Vector3.new(CFG.HitboxSize, CFG.HitboxSize, CFG.HitboxSize)  
                        rootPart.Transparency = CFG.HitboxTrans / 100  
                        rootPart.CanCollide = false  
                          
                        if CFG.HitboxGlow then  
                            if not highlight then  
                                highlight = Instance.new("Highlight")  
                                highlight.Name = "sirotaninHitboxGlow"  
                                highlight.Parent = pChar  
                            end  
                            highlight.FillColor = CFG.HitboxColor  
                            highlight.FillTransparency = CFG.HitboxTrans / 100  
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)  
                            highlight.Enabled = true  
                        else  
                            if highlight then highlight.Enabled = false end  
                        end  
                    else  
                        rootPart.Size = Vector3.new(2, 2, 1)  
                        rootPart.Transparency = 1  
                        if highlight then highlight.Enabled = false end  
                    end  
                end  

                local chams = pChar:FindFirstChild("sirotaninHighlight")  
                if CFG.ChamsEnabled then  
                    if not chams then  
                        chams = Instance.new("Highlight")  
                        chams.Name = "sirotaninHighlight"  
                        chams.Parent = pChar  
                    end  
                    chams.FillColor = CFG.ChamsColor  
                    chams.FillTransparency = CFG.ChamsTrans / 100  
                    chams.OutlineColor = Color3.fromRGB(255, 255, 255)  
                    chams.Enabled = true  
                else  
                    if chams then chams.Enabled = false end  
                end 
            end  
        end
    end
end)

