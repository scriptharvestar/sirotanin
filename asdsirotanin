            GhostClone.Name = "sirotaninGhostSkin"
            GhostClone.Parent = workspace
            
            for _, d in ipairs(GhostClone:GetDescendants()) do
                if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
            end
            
